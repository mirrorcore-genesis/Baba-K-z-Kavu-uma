# BACKEND
PORT=4000
NODE_ENV=production
DATABASE_URL=postgresql://babakiz_user:secret_password@postgres:5432/babakiz_db
REDIS_URL=redis://redis:6379
S3_REGION=auto
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key
S3_BUCKET=babakiz-media

# WEB (NEXT.JS)
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_URL=https://api.senindomainin.com
NEXT_PUBLIC_WS_URL=wss://api.senindomainin.com/ws